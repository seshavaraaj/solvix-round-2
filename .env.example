# Copy to .env for local runs. Never commit .env.
# DATABASE_URL defaults to SQLite at <repo>/transitpulse.db. Render sets a Postgres URL.
# DATABASE_URL=postgresql://user:pass@host/db
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
OPERATOR_PASSWORD=operator-local
ADMIN_PASSWORD=admin-local
LIVE_MODE=false
GTFS_RT_KEY=
